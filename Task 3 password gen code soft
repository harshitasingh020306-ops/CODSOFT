import random

letters = "abcdefghijklmnopqrstuvwxyz"
capletters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
numbers = "0123456789"
symbols = "!@#$"

print("password generator")
print("-------------------")

go = True

while go == True:
    
    print(" ")
    print("1 simple")
    print("2 medium")  
    print("3 strong")
    print("4 exit")
    
    choice = input("select: ")
    
    if choice == "4":
        go = False
    
    if choice == "1" or choice == "2" or choice == "3":
        
        length = input("enter length: ")
        length = int(length)
        
        password = ""
        
        if choice == "1":
            allletters = letters + capletters
            for i in range(length):
                password = password + random.choice(allletters)
                
        if choice == "2":
            allletters = letters + capletters
            allchars = allletters + numbers
            for i in range(length):
                password = password + random.choice(allchars)
                
        if choice == "3":
            allletters = letters + capletters
            allchars = allletters + numbers + symbols
            for i in range(length):
                password = password + random.choice(allchars)
        
        print("password =", password)
        print("length =", length)
        
    if choice != "1" and choice != "2" and choice != "3" and choice != "4":
        print("wrong input")

print("bye bye 🌷")
